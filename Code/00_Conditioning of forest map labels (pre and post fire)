def asignar_etiqueta(x):
    if x in ['Sin información']:
        return 'Sin información'
    elif x in ['Desierto por incendios','Semidesierto por incendio reiterado']:
        return 'Desierto por incendios'
    elif x in ['Tamarix canariensis','Ulex parviflorus','Genista scorpius','Desierto rocoso, no kárstico, roquedo compacto','Matorral mixto con predominio de Anthyllis cytisoides','Matorral mixto con predominio de romero', 'Cistus albidus', 'Phragmites australis (carrizal)','Rosmarinus sp.','Matorral mixto con predominio de Ulex parviflorus','Matorral mixto, s.l.','Matorral mixto nitro-termófilo','Pastizal estacional denso','Cistus laurifolius','Matorral mixto calcícola','Ononis tridentata','Semidesierto de canchales, gleras, cascajares y pedregales','Brachypodium retusum','Galería arbustiva mixta','Rosmarinus officinalis','Arundo donax','Lasto-Mato-Erizal','Lasto-Erizal','Matorral mixto calcícola con participación apreciable de espinosas','Cultivos agrícolas','Juniperus oxycedrus','Sabino-enebral','Nerium oleander','Pastizal leñoso mixto: Especies ± xerófilas','Juniperus phoenicea','Matorral mixto silicícola (composición dependiente de la comarca y la altitud)','Cañar o carrizal mixto']:
        return 'Cult_Arb_Past'
    elif x in ['Mezcla de coníferas y frondosas con predominio de exóticas','Bosque mixto de subsclerófilos y coníferas','Galería arbórea mixta']:
        return 'Mixto'
    elif x in ['Quercus, varias especies en mezcla','Quercus ilex rotundifolia','Quercus faginea','Garriga media degradada','Quercus coccifera','Mezcla de Quercus ilex ilex y Quercus ilex rotundifolia','Quercus suber','Garriga alta y densa','Garriga clara, muy degradada o incipiente']:
        return 'Quercus'
    elif x in ['mezcla de varias especies del género Pinus','Pinus halepensis','Pinus nigra','Pinus pinaster','Mezcla de varias especies de pinos','Pinus pinea','Pinus sylvestris']:
        return 'Pinus'
    elif x in ['Populus nigra']:
        return 'Populus'
    elif x in ['Acer granatense','Platanus hybrida']:
        return 'Otras Frondosas'
#     elif x in []:
#         return 'Otras Coniferas'
    elif x in ['áreas en proceso de urbanización o urbanizadas','Desierto por excavaciones o escombreras de minas y canteras','Agua','Semidesierto rocoso, no kárstico']:
        return 'Otros'
    else:
        return None

unido['Label'] = unido['Nombre'].apply(asignar_etiqueta)

def asignar_etiqueta_MFEact(x):
    if x in ['sin datos']:
        return 'Sin información'
    elif x in ['Arbutus unedo','Tamarix spp.','Juniperus thurifera','Juniperus oxycedrus','Juniperus phoenicea']:
        return 'Cult_Arb_Past'
    elif x in [ 'Quercus ilex','Quercus faginea','Quercus suber',]:
        return 'Quercus'
    elif x in ['Pinus nigra','Pinus pinaster','Pinus halepensis','Pinus pinea','Pinus sylvestris']:
        return 'Pinus'
    elif x in ['Populus x canadensis','Populus alba','Populus nigra']:
        return 'Populus'
    elif x in [ 'Prunus spp.','Olea europaea','Crataegus monogyna','Fraxinus ornus','Salix spp.','Eucalyptus camaldulensis','Ceratonia siliqua']:
        return 'Otras Frondosas'
    else:
        return None

