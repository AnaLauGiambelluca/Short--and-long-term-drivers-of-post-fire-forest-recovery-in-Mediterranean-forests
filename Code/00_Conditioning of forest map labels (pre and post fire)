# We created a function that allows matching each label from the 1985 Forest Map with general labels.
def asignar_etiqueta(x):
    if x in ['Sin información']:
        return 'Sin información'
    elif x in ['Desierto por incendios']:
        return 'Desierto por incendios'
    elif x in ['Bojar mixto', 'Tojar extramediterráneo. Mezcla de spp. de Ulex o bien tojar con matorral mixto', 'Estepa leñosa', 'Juniperus oxycedrus', 'Calluna vulgaris', 'Pastizal leñoso mixto: especies ± hidrófilas, en dominios de bosque caducifolio', 'Buxus sempervirens', 'Lasto-timo-aliagar', 'Pteridium aquilinum, o helechar de altura', 'Brachypodium retusum', 'Herbazal anual', 'Césped denso de altura, "tasca"', 'Prado de diente', 'Prado de siega', 'Cultivos agrícolas']:
        return 'Cult_Arb_Past'
    elif x in ['Arbolado mixto caducifolio, en España Mediterránea', 'Mezcla de frondosas autóctonas con frondosas y coníferas exóticas', 'Galería arbórea mixta']:
        return 'Mixto'
    elif x in ['Quercus robur','Quercus faginea','Mezcla de Quercus ilex ilex y Quercus ilex rotundifolia','Garriga alta y densa','Quercus ilex rotundifolia','Quercus coccifera','Garriga media degradada','Quercus petraea']:
        return 'Quercus'
    elif x in ['Pinus sylvestris','Pinus nigra nigra','Pinus halepensis','Pinus nigra','Pinus radiata']:
        return 'Pinus'
    elif x in ['Populus x canadensis']:
        return 'Populus'
    elif x in ['Crataegus monogyna','Fagus sylvatica','Castanea sativa']:
        return 'Otras Frondosas'
    elif x in ['Larix, una o varias especies']:
        return 'Otras Coniferas'
    else:
        return None

# We apply the function to the 'Name' column and storaged the information in the 'Label' column.
unido['Label'] = unido['Nombre'].apply(asignar_etiqueta)

# We created a function that allows matching each label from the post-fire Forest Map with general labels.
def asignar_etiqueta_MFEact(x):
    if x in ['sin datos']:
        return 'Sin información'
    elif x in ['Arbutus unedo','Juniperus oxycedrus']:
        return 'Cult_Arb_Past'
    elif x in ['Quercus robur','Quercus pyrenaica','Quercus rubra','Quercus faginea','Quercus humilis (Q. Pubescens)','Quercus ilex','Quercus petraea']:
        return 'Quercus'
    elif x in ['Pinus sylvestris','Pinus halepensis','Pinus nigra','Pinus strobus','Pinus radiata']:
        return 'Pinus'
    elif x in ['Populus x canadensis','Populus nigra']:
        return 'Populus'
    elif x in ['Platanus hispanica','Betula spp.','Fraxinus angustifolia','Robinia pseudoacacia','Fagus sylvatica','Salix elaeagnos','Betula alba','Alnus glutinosa','Betula pendula','Castanea sativa']:
        return 'Otras Frondosas'
    elif x in ['Larix spp.','Otra Coniferas','Picea abies','Larix decidua','Pseudotsuga menziesii']:
        return 'Otras Coniferas'
    else:
        return None

# We apply the function to the 'Especie1' column and storaged the information in the 'Label_MFEact' column.
unido['Label_MFEact'] = unido['Especie1'].apply(asignar_etiqueta_MFEact)

# We select the plots that have the same label
coinciden=unido.loc[(unido['Label_MFEact']==unido['Label'])]

#We export the result
coinciden.to_file("exported_data_Navarra.shp")

