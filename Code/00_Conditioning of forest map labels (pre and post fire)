def asignar_etiqueta(x):
    if x in ['Sin información']:
        return 'Sin información'
    elif x in ['Desierto por incendios','Semidesierto por incendio reiterado']:
        return 'Desierto por incendios'
    elif x in ['Genista scorpius', 'Pastizal estacional denso','Césped denso de altura, "tasca"','Bosque mixto de subsclerófilos y esclerófilos','Mancha degradada', 'Ulex parviflorus','Matorral mixto con predominio de Ulex parviflorus','Buxus sempervirens','Erica arborea', 'Cultivos agrícolas', 'Romeral mixto','Brezal xerófilo mixto', 'Matorral mixto calcícola','Cytisus purgans', 'Pastizal leñoso mixto: especies ± hidrófilas, en dominios de bosque caducifolio','Lasto-timo-aliagar', 'Rosmarinus officinalis','Cistus albidus', 'Juniperus communis communis','Matorral mixto, s.l.', 'Matorral mixto con predominio de romero','Arbutus unedo','Pteridium aquilinum, o helechar de altura','Jaral mezclado.- Cistus, varias especies, en mezcla','Matorral mixto silicícola (composición dependiente de la comarca y la altitud)','Prado de siega', 'Pastizal leñoso mixto: Especies ± xerófilas','Cistus monspeliensis', 'Artemisia herba-alba', 'Juniperus communis hemisphaerica','Lastonar mixto','Mancha alta y densa', 'Prado de diente', 'Juniperus oxycedrus']:
        return 'Cult_Arb_Past'
    elif x in ['Bosque de elevada heterogeneidad','Soto mixto arbóreo','Bosque mixto caducifolio (fraga) en enclaves en España Mediterránea','Galería arbustiva mixta','Bosque mixto de pie de cantil','Galería arbórea mixta', 'Bosque mixto de caducifolios y subsclerófilos']:
        return 'Mixto'
    elif x in ['Garriga media degradada', 'Quercus faginea', 'Quercus, varias especies en mezcla', 'Quercus suber','Mezcla de Quercus ilex ilex y Quercus ilex rotundifolia', 'Quercus pubescens', 'Quercus coccifera', 'Garriga clara, muy degradada o incipiente','Quercus ilex rotundifolia', 'Quercus ilex ilex', 'Quercus gr. faginea. Varias estirpes infraspecíficas o de difícil adscripción']:
        return 'Quercus'
    elif x in ['Pinus uncinata','Pinus radiata', 'Pinus halepensis','Pinus nigra', 'Pinus sylvestris', 'Pinus pinea','Pinus pinaster', 'mezcla de varias especies del género Pinus','Mezcla de varias especies de pinos']:
        return 'Pinus'
    elif x in ['Populus x canadensis']:
        return 'Populus'
    elif x in ['Platanus hybrida','Alnus glutinosa','Eucalyptus sp.','Fraxinus excelsior','Betula pendula', 'Fagus sylvatica','Corylus avellana','Fraxinus angustifolia']:
        return 'Otras Frondosas'
#     elif x in []:
#         return 'Otras Coniferas'
    elif x in ['Desierto kárstico','Semidesierto de erosión','Agua','áreas en proceso de urbanización o urbanizadas','Desierto de roca compacta','Desierto rocoso, no kárstico, roquedo compacto','Semidesierto rocoso, no kárstico']:
        return 'Otros'
    else:
        return None

unido['Label'] = unido['Nombre'].apply(asignar_etiqueta)

def asignar_etiqueta_MFEact(x):
    if x in ['sin datos']:
        return 'Sin información'
    elif x in ['Arbutus unedo','Tamarix spp.','Juniperus oxycedrus',]:
        return 'Cult_Arb_Past'
    elif x in ['Quercus humilis (Q. Pubescens)','Quercus ilex','Quercus faginea','Quercus robur','Quercus pyrenaica','Quercus suber','Quercus petraea']:
        return 'Quercus'
    elif x in ['Pinus nigra', 'Pinus radiata','Pinus halepensis','Pinus pinaster','Pinus canariensis','Pinus uncinata','Pinus pinea','Pinus sylvestris']:
        return 'Pinus'
    elif x in ['Populus x canadensis','Populus alba','Populus tremula','Populus nigra']:
        return 'Populus'
    elif x in ['Prunus spp.', 'Eucalyptus camaldulensis','Platanus hispanica','Salix elaeagnos','Olea europaea','Otras frondosas', 'Ceratonia siliqua','Fraxinus excelsior','Betula pendula', 'Ulmus minor','Betula spp.','Salix atrocinerea', 'Castanea sativa','Salix spp.', 'Corylus avellana','Fagus sylvatica','Salix caprea', 'Alnus glutinosa','Eucalyptus globulus','Ulmus pumila', 'Fraxinus angustifolia','Robinia pseudoacacia']:
        return 'Otras Frondosas'
    elif x in ['Mezcla de árboles de ribera']:
        return 'Mixto'
    elif x in ['Cupressus sempervirens','Cedrus atlantica']:
        return 'Otras Coniferas'
    else:
        return None

