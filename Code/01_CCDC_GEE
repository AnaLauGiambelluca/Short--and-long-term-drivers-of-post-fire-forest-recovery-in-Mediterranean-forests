//Step 1: Extract breakage raster

// We set the study period
var inputParams = {
  start: '1983-01-01',
  end: '2020-12-31',
};

// We set the parameters
var changeDetectionParameters = {
  breakpointBands: ['NBR'],
  minObservations: 3,
  chiSquareProbability: 0.99,
  minNumOfYearsScaler: 1.33,
  dateFormat: 1,
  lambda: 0.002,
  maxIterations: 25000
};

// Put the Landsat collection into the change detection parameters
changeDetectionParameters.collection = filteredLandsat.select('NBR');

// Run CCDC
var results = ee.Algorithms.TemporalSegmentation.Ccdc(changeDetectionParameters);


// Combine parameters to save them as metadata
var paramsCombined = ee.Dictionary(changeDetectionParameters).combine(inputParams).remove(['collection']);


