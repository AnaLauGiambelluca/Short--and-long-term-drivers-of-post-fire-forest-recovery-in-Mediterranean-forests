// Load the Landsat 4 Collection
var Landsat4 = ee.ImageCollection('LANDSAT/LT04/C02/T1_L2')
    .filterDate('1983-01-01', '1993-06-24') // Filter date
    .filterMetadata('CLOUD_COVER','Less_Than',50) // Filter percentage of cloud
    .filterBounds(area) // Filter bounding box
    .map(mask457sr) // Apply cloud mask
//Calculate the NBR index
    .map(function addNBR(image) {
    var NBRI = image.expression ('((NIR - SWIR)+0.000000000000000000001) / (NIR + SWIR)', {
    'NIR': image.select ('SR_B4'),  
    'SWIR': image.select ('SR_B7')}).rename('NBR');
    
    return image.addBands([NBRI])}); 

// Load the Landsat 5 Collection
